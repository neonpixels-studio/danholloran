{
  "name": "danholloran-me",
  "version": "1.0.0",
  "description": "Personal blog and portfolio for Dan Holloran — full-stack developer and photographer based in Reno, NV.",
  "type": "module",
  "scripts": {
    "build": "npm run resume:pdf:check && vitepress build",
    "build:production": "dotenvx run --strict -f .env.production -- npm run build",
    "preview": "vitepress preview",
    "dev": "npm run images && vitepress dev",
    "grimicorn:zips": "node .vitepress/scripts/buildGrimicornZips.ts",
    "images": "node .vitepress/scripts/generateImageVariants.ts",
    "images:static": "node .vitepress/scripts/generateStaticImageFormats.ts",
    "resume:pdf:check": "node .vitepress/scripts/checkResumePdfSynced.ts",
    "resume:pdf:sync": "node .vitepress/scripts/markResumePdfSynced.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lighthouse": "lhci autorun",
    "lint": "node scripts/prettier-skip-drafts.mjs --check . && eslint . && fallow audit",
    "lint:fix": "node scripts/prettier-skip-drafts.mjs --write . && eslint . --fix && fallow fix --yes",
    "prepare": "husky || true"
  },
  "author": "Dan Holloran",
  "license": "MIT",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/ui": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "fallow": "^3.45.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14",
    "xml-js": "^1.6.11"
  },
  "dependencies": {
    "@neon-pixels/security": "^0.5.0",
    "@neon-pixels/sentry": "^0.4.0",
    "@sentry/vite-plugin": "^11.18.0",
    "@sentry/vue": "^11.18.0",
    "@tailwindcss/vite": "^4.3.5",
    "feed": "^6.0.0",
    "image-size": "^2.1.0",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "plist": "^5.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.5",
    "brace-expansion": "^5.0.12",
    "vite": "^6.4.5",
    "vitepress": {
      "vite": "5.4.21"
    }
  }
}
