{
  "name": "danholloran-me",
  "version": "1.0.0",
  "description": "Personal blog and portfolio for Dan Holloran — full-stack developer and photographer based in Reno, NV.",
  "type": "module",
  "scripts": {
    "build": "npm run resume:pdf:check && vitepress build",
    "preview": "vitepress preview",
    "dev": "npm run images && vitepress dev",
    "images": "node .vitepress/scripts/generateImageVariants.ts",
    "resume:pdf:check": "node .vitepress/scripts/checkResumePdfSynced.ts",
    "resume:pdf:sync": "node .vitepress/scripts/markResumePdfSynced.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "prettier --check . && eslint . && fallow audit",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix",
    "prepare": "husky || true"
  },
  "author": "Dan Holloran",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fallow": "^3.31.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "xml-js": "^1.6.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "feed": "^6.0.0",
    "image-size": "^2.0.4",
    "minisearch": "^7.2.0",
    "plist": "^5.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  }
}
