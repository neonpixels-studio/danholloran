# dotenvx: refuse the commit if any tracked .env* file holds plaintext values.
# `ext precommit` is deprecated in favor of `dotenvx protect`, but protect is not
# a gate: it exits 0 even with plaintext staged. Keep ext precommit; ignore its
# deprecation warning.
npx dotenvx ext precommit

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "WARNING: gitleaks is not installed, so the pre-commit secret scan was SKIPPED." >&2
  echo "Install it with 'brew install gitleaks' (see https://github.com/gitleaks/gitleaks#installing). CI still scans pull requests and pushes to main." >&2
  exit 0
fi
gitleaks git --staged --redact --config .gitleaks.toml
