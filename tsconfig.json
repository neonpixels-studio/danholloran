{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [".vitepress/*"],
      "@": [".vitepress"],
      "@components/*": [".vitepress/theme/components/*"],
      "@components": [".vitepress/theme/components"],
      "@theme/*": [".vitepress/theme/*"],
      "@theme": [".vitepress/theme"],
      "@typedefs/*": [".vitepress/types/*"],
      "@typedefs": [".vitepress/types"],
      "@data/*": [".vitepress/data/*"],
      "@data": [".vitepress/data"],
      "@composables/*": [".vitepress/theme/composables/*"],
      "@composables": [".vitepress/theme/composables"],
      "@content/*": [".vitepress/content/*"],
      "@content": [".vitepress/content"],
      "@utils/*": [".vitepress/theme/utils/*"],
      "@utils": [".vitepress/theme/utils"],
      "@views/*": [".vitepress/theme/views/*"],
      "@views": [".vitepress/theme/views"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue"
  ],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
