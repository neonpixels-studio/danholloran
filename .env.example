# Every variable in .env.production, with where to obtain it. The real values
# live encrypted in .env.production (Netlify production build only); set one
# with `npx dotenvx set KEY value -f .env.production`, which encrypts it.
# Names here must match .env.production (enforced by
# .vitepress/tests/config/envFiles.test.ts). Never put a value in this file.

# Sentry organization slug, the first path segment of your Sentry URL.
SENTRY_ORG=

# Sentry project slug, from https://sentry.io -> Settings -> Projects.
SENTRY_PROJECT=

# Source map upload token: https://sentry.io -> Settings -> Auth Tokens
# (org token with project:releases + org:read).
SENTRY_AUTH_TOKEN=
