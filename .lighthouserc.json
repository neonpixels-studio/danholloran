{
  "ci": {
    "collect": {
      "staticDistDir": ".vitepress/dist",
      "url": [
        "http://localhost/",
        "http://localhost/posts/",
        "http://localhost/posts/wp-better-attachments.html",
        "http://localhost/posts/laravel-and-websockets.html",
        "http://localhost/resume.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.5
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.85
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
