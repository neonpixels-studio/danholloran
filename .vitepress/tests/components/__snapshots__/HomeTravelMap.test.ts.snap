          <path d="M6 1.5C3.9 1.5 2.2 3.2 2.2 5.3c0 2.7 3.8 6.2 3.8 6.2s3.8-3.5 3.8-6.2C9.8 3.2 8.1 1.5 6 1.5Z" data-v-d657fdb1=""></path>
