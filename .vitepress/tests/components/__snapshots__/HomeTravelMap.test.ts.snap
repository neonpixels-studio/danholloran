    <div data-v-d657fdb1="" class="stagger in grid grid-cols-5 gap-6 max-md:grid-cols-2 max-sm:grid-cols-2">
      <div data-v-d657fdb1="" class="border-accent border-t-2 pt-4">
        <div data-v-d657fdb1="" class="tracking-tightest font-mono leading-none font-bold">47<span data-v-d657fdb1="" class="text-fg-subtle ml-1 text-[0.85rem] font-medium">/50</span></div>
        <div data-v-d657fdb1="" class="text-fg-subtle mt-2.5 font-mono text-[0.6rem] tracking-widest uppercase"> states visited </div>
