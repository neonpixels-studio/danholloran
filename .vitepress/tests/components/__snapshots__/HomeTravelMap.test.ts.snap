        <div data-v-d657fdb1="" class="text-fg-subtle mt-2.5 font-mono text-[0.6rem] tracking-widest uppercase"> national parks </div>
      </div>
      <div data-v-d657fdb1="" class="border-line border-t-2 pt-4">
