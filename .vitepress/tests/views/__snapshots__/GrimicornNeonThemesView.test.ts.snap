exports[`GrimicornNeonThemesView > swatch copy feedback styling > applies the copy-failed styling hook after a rejected copy 1`] = `"<span data-v-c47154f1="" class="copy-hex font-mono text-[0.62rem] hex-text-a855f7 copy-failed-flash">couldn't copy</span>"`;

exports[`GrimicornNeonThemesView > swatch copy feedback styling > has no flash classes while idle 1`] = `"<span data-v-c47154f1="" class="copy-hex font-mono text-[0.62rem] hex-text-2323ff">#2323FF</span>"`;

exports[`GrimicornNeonThemesView > swatch copy feedback styling > shows the copied label without the failure hook after a successful copy 1`] = `"<span data-v-c47154f1="" class="copy-hex font-mono text-[0.62rem] hex-text-2323ff">copied!</span>"`;
