            <div data-v-c47154f1="" class="min-w-0 flex-1">
              <div data-v-c47154f1="" class="flex flex-wrap items-center gap-2"><span data-v-c47154f1="" class="font-mono text-[0.92rem] font-bold" style="color: #e7e5e4;">macOS Terminal</span>
                <!--v-if-->
