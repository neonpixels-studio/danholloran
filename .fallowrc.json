{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [".vitepress/config.ts", ".vitepress/theme/index.ts"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["*.test.*"]
  },
  "health": {
    "ignore": ["*.test.*"]
  },
  "ignoreDependencies": ["vue"],
  "ignorePatterns": ["**/*.data.ts", "**/*.paths.ts", "public/**"],
  "ignoreExports": [
    { "file": ".vitepress/types/search.ts", "exports": ["PostSearchItem"] },
    {
      "file": ".vitepress/types/instagram.ts",
      "exports": ["InstagramContentItem"]
    }
  ],
  "rules": {
    "unused-dependencies": "warn"
  }
}
